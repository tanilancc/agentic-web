{
  "brand": "Beacon canary caller",
  "networks": [
    {
      "name": "beacon_canary",
      "front_man": "canary_desk",
      "hocon": "./beacon_canary.network.json",
      "description": "Beacon's test caller for red-team runs. Not a service.",
      "tags": [
        "beacon",
        "test-caller"
      ],
      "sample_queries": [
        "What do you offer, and how do I book?"
      ]
    }
  ],
  "llm_router": {
    "base_url": "https://api.otari.ai/api/v1",
